{
  "name": "Chess Coach",
  "short_name": "Chess Coach",
  "description": "Personal chess trainer: analyse your games, find your weaknesses, test yourself and train.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f5f2",
  "theme_color": "#2f6f4f",
  "categories": ["games", "education", "sports"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Test", "url": "./?tab=test", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Puzzles", "url": "./?tab=puzzles", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
